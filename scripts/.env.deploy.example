# scripts/.env.deploy.example
# -----------------------------------------------------------------------------
# Copy this file to scripts/.env.deploy and fill in real values.
# scripts/.env.deploy is gitignored — NEVER commit it.
#
# These values are pushed to BOTH GitHub Actions secrets AND Railway
# variables when you run `pwsh scripts/sync-secrets.ps1`.
# -----------------------------------------------------------------------------

# ── App secrets (32+ chars; generate with: python -c "import secrets;print(secrets.token_urlsafe(48))") ──
FLASK_SECRET=replace-me-with-a-strong-random-string-of-at-least-32-chars
JWT_SECRET=replace-me-with-a-different-strong-random-string-32-plus-chars

# ── Anthropic ──
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub OAuth (production app) ──
GITHUB_CLIENT_ID=Ov23li2NYBAmBc3gskJX
GITHUB_CLIENT_SECRET=replace-with-NEW-secret-after-rotating
GITHUB_REDIRECT_URI=https://www.jobspilot.site/api/auth/github/callback

# ── Google OAuth (optional) ──
# GOOGLE_CLIENT_ID=

# ── Apify (optional) ──
# APIFY_TOKEN=
