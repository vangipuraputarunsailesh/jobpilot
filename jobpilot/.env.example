# Required
FLASK_SECRET=
JWT_SECRET=

# Google Sign-In is the ONLY identity provider (Phase 1 of the BYOK +
# Drive refactor). Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials and set:
#   • Authorized JavaScript origins: https://<your-host> + http://localhost:5000
#   • Authorized redirect URIs:      (none — we use GIS One-Tap / Token Client)
# The client-side flow requests these scopes:
#   openid email profile
#   https://www.googleapis.com/auth/drive.appdata   (hidden per-app folder)
#   https://www.googleapis.com/auth/drive.file      (files the user picks/creates)
# CLIENT_SECRET is no longer used at runtime but is kept for tooling/back-compat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo-mode fallback only. Real users supply their own keys via the in-app
# Settings panel (BYOK, Phase 2). These are used solely when a request
# comes from the demo account, and the demo path has a tighter rate limit.
ANTHROPIC_API_KEY=

# Optional — override the Claude model used by the AI engine.
# Default is `claude-sonnet-4-5` (the stable alias for the current released line).
# Only override if Anthropic ships a newer SKU you want to pin to.
CLAUDE_MODEL=claude-sonnet-4-5

# Demo-mode fallback only — real users supply their own RapidAPI / Adzuna
# / USAJobs credentials via the Settings panel (BYOK, Phase 2).
RAPIDAPI_KEY=
APIFY_API_TOKEN=
# Optional — pin a specific Apify modular actor (otherwise auto-discovered)
APIFY_MODULAR_ACTOR_ID=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional
USAJOBS_API_KEY=
USAJOBS_EMAIL=
