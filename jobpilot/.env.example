# Required
ANTHROPIC_API_KEY=
FLASK_SECRET=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App credentials — enables "Continue with GitHub" on the
# landing page. Register at https://github.com/settings/developers and
# set the Authorization callback URL to <your-host>/api/auth/github/callback.
# Both client id AND secret must be set for the button to render.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional — explicit override for the OAuth callback URL. If unset,
# Flask builds it from the incoming request (works for prod + localhost).
GITHUB_REDIRECT_URI=

# Optional — override the Claude model used by the AI engine.
# Default is `claude-sonnet-4-5` (the stable alias for the current released line).
# Only override if Anthropic ships a newer SKU you want to pin to.
CLAUDE_MODEL=claude-sonnet-4-5

# Job APIs
RAPIDAPI_KEY=
APIFY_API_TOKEN=
# Optional — pin a specific Apify modular actor (otherwise auto-discovered)
APIFY_MODULAR_ACTOR_ID=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional
USAJOBS_API_KEY=
USAJOBS_EMAIL=
